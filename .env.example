# ==============================================================================
# MailMind AI — Production & Local Environment Configuration Template
# Copy this file to .env (or configure in Render / Vercel dashboard)
# NEVER commit secrets or your real .env to git.
# ==============================================================================

# Server Network Configuration
PORT=5001
NODE_ENV=development

# Application Public URLs (Required for OAuth redirect & CSRF/Origin validation)
# Raasta A (All-in-one on Render): https://<your-render-app>.onrender.com
# Raasta B (Frontend on Vercel): https://<your-vercel-app>.vercel.app
APP_URL=http://localhost:5174

# Optional: CORS allowed origins (Required if frontend is on a separate origin and not proxied)
CLIENT_ORIGIN=http://localhost:5174

# Google Cloud OAuth 2.0 Credentials (Gmail API)
# Obtain at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:5001/api/auth/callback

# Groq High-Speed LPU API Key
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_CHAT_MODEL=openai/gpt-oss-20b
GROQ_PROMPT_GUARD_MODEL=meta-llama/llama-prompt-guard-2-22m

# AES-256-GCM 32-Byte Token Encryption Key (64-character hex string)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENC_KEY=your_64_character_hex_encryption_key_here

# Session Secret for Cookie Signing
SESSION_SECRET=your_random_session_secret_hex_here

# SQLite Database File Path (Optional, for persistent disk mounts like Render Disks)
# Default: ./server/mailmind.db
# On persistent disk: /var/data/mailmind.db
# SQLITE_PATH=/var/data/mailmind.db

# Feature Flags
FEATURE_REGRET_SHIELD=true
FEATURE_SENDER_TRUST=true
SENT_SYNC_LIMIT=300
