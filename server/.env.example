PORT=5001
CLIENT_URL=http://localhost:5174

# Google Gemini API Key for Email Intelligence
GEMINI_API_KEY=your_gemini_api_key_here

# Google Cloud OAuth 2.0 Credentials (for Gmail API access)
# Obtain these at https://console.cloud.google.com/apis/credentials
# Ensure Gmail API is enabled and redirect URI http://localhost:5001/api/auth/callback is authorized.
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:5001/api/auth/callback
