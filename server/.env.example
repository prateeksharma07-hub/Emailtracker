# ==============================================================================
# MailMind AI — Server Environment Configuration Template
# ==============================================================================

PORT=5001
NODE_ENV=development
APP_URL=http://localhost:5174
CLIENT_ORIGIN=http://localhost:5174
CLIENT_URL=http://localhost:5174

# Groq High-Speed LPU API Key for Autonomous Email Intelligence
GROQ_API_KEY=your_groq_api_key_here
GROQ_CHAT_MODEL=openai/gpt-oss-20b
GROQ_PROMPT_GUARD_MODEL=meta-llama/llama-prompt-guard-2-22m

# Google Cloud OAuth 2.0 Credentials (for Gmail API access)
# Obtain these at https://console.cloud.google.com/apis/credentials
# Ensure Gmail API is enabled and redirect URI is authorized.
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:5001/api/auth/callback

# Multi-User Token Encryption Key (AES-256-GCM 32-byte / 64-hex key)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENC_KEY=your_32_byte_hex_encryption_key_here

# Session Secret for Cookie Signing
SESSION_SECRET=your_session_secret_here

# SQLite Database File Path (Optional, for persistent disk mounts like Render Disks)
# SQLITE_PATH=/var/data/mailmind.db

# Feature Flags
FEATURE_REGRET_SHIELD=true
FEATURE_SENDER_TRUST=true
SENT_SYNC_LIMIT=300
